# ── SUPABASE ────────────────────────────────────────────────────────────────
# URL del proyecto y service key (bypassea RLS — guardar con cuidado)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=eyJ...tu_service_key

# ── BREVO SMTP (backup por email) ────────────────────────────────────────────
# Credenciales SMTP de https://app.brevo.com/settings/account/smtp
BREVO_SMTP_LOGIN=b2101c001@smtp-brevo.com
BREVO_SMTP_PASSWORD=tu_password_smtp
# Correo remitente (verificado en Brevo)
BACKUP_EMAIL_FROM=tu-email@verificado.com
# Destinatarios separados por coma
BACKUP_EMAIL_TO=gerencia@altrans.dev, julian@altrans.dev

# ── WHATSAPP META CLOUD API ─────────────────────────────────────────────────
# Token de acceso generado en Facebook Business → WhatsApp → API
WA_TOKEN=EAAT...
# ID del número de teléfono de WhatsApp Business
WA_PHONE_NUMBER_ID=123456789

# ── ADMIN (protección endpoints manuales) ───────────────────────────────────
# Token para POST /admin/backup y POST /admin/notify/wa
ADMIN_TOKEN=a6b5a5f92044e4a742bf46c958efdb9730919668a1558cf78d8a4d4667937af5

# ── LOGGING ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
